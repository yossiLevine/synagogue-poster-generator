{
  "name": "BugReport",
  "type": "object",
  "properties": {
    "bug_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d1\u05d0\u05d2"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05d1\u05d0\u05d2"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05e4\u05d5\u05e8\u05d8 \u05e9\u05dc \u05d4\u05d1\u05d0\u05d2"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium"
      ],
      "description": "\u05e8\u05de\u05ea \u05d7\u05d5\u05de\u05e8\u05d4"
    },
    "category": {
      "type": "string",
      "enum": [
        "security",
        "functionality",
        "ux",
        "performance"
      ],
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "fixed"
      ],
      "default": "new",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d1\u05d0\u05d2"
    }
  },
  "required": [
    "bug_id",
    "title",
    "description",
    "severity",
    "category"
  ]
}