{
  "name": "SynagogueAccount",
  "type": "object",
  "properties": {
    "synagogue_id": {
      "type": "string",
      "description": "ID \u05e9\u05dc \u05d1\u05d9\u05ea \u05d4\u05db\u05e0\u05e1\u05ea"
    },
    "username": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05ea\u05de\u05e9"
    },
    "password_hash": {
      "type": "string",
      "description": "\u05e1\u05d9\u05e1\u05de\u05d4 \u05de\u05d5\u05e6\u05e4\u05e0\u05ea"
    },
    "email": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d3\u05d5\u05d0\"\u05dc"
    },
    "phone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df (\u05e2\u05dd \u05e7\u05d9\u05d3\u05d5\u05de\u05ea \u05d1\u05d9\u05e0\u05dc\u05d0\u05d5\u05de\u05d9\u05ea, \u05dc\u05d3\u05d5\u05d2\u05de\u05d0: +972505555555)"
    },
    "role": {
      "type": "string",
      "enum": [
        "gabaai",
        "admin"
      ],
      "default": "gabaai",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3: \u05d2\u05d1\u05d0\u05d9 \u05d0\u05d5 \u05d0\u05d3\u05de\u05d9\u05df \u05d1\u05d9\u05ea \u05db\u05e0\u05e1\u05ea"
    },
    "subscribed_to_reminders": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05de\u05e0\u05d5\u05d9 \u05dc\u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05e9\u05d1\u05d5\u05e2\u05d9\u05d5\u05ea"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d7\u05e9\u05d1\u05d5\u05df \u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "synagogue_id",
    "username",
    "password_hash"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}