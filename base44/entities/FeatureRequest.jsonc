{
  "name": "FeatureRequest",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05d1\u05e7\u05e9\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05e4\u05d5\u05e8\u05d8 \u05e9\u05dc \u05d4\u05e4\u05d9\u05e6'\u05e8"
    },
    "requested_by": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d2\u05d1\u05d0\u05d9 \u05e9\u05d4\u05d5\u05d2\u05d4 \u05d0\u05ea \u05d4\u05d1\u05e7\u05e9\u05d4"
    },
    "synagogue_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d1\u05d9\u05ea \u05d4\u05db\u05e0\u05e1\u05ea"
    },
    "likes": {
      "type": "integer",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05dc\u05d9\u05d9\u05e7\u05d9\u05dd"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "planned",
        "completed"
      ],
      "default": "new",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d1\u05e7\u05e9\u05d4"
    }
  },
  "required": [
    "title",
    "requested_by",
    "synagogue_name"
  ]
}